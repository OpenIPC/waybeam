#!/bin/sh
# Persistent CV610 IMX662 MPP module profile. Uses the registration-only PM
# shim, never the vendor open_pm implementation.

set -u

MODULE_DIR=${MODULE_DIR:-/lib/modules/$(uname -r)/hisilicon}
ARTIFACT_DIR=${ARTIFACT_DIR:-/usr/lib/cv610}
# The MMZ zone open_mmz is handed, and which allocator provides it. A
# hi3516cv6xx kernel with hisi_mem (OpenIPC/firmware #2638, October 2026, and
# later) measures DRAM, lays memory out itself and publishes the result under
# /sys/module/hisi_mem/parameters, ignoring mem= and the u-boot env's
# totalmem/osmem ("64M of memory from the bootloader ignored, DRAM is 128M");
# both are read from there, the way OpenIPC's own load_hisilicon does.
# Without hisi_mem the zone is a bootloader carve-out, taken from the
# command line or from CV610_MMZ_START/SIZE below.
#
# This is not cosmetic. With hisi_mem present the zone lies INSIDE kernel
# memory, so mmz_allocator=ot -- MMZ's own carve-out, which is what a
# bootloader-driven layout needs -- is rejected outright and the boot comes up
# with no MPP modules at all:
#   Conflict MMZ: PHYS(0x42000000, 0x47FFFFFF), nBYTES=98304KB
#   MMZ conflict to kernel memory (0x40000000, 0x47FFFFFF)
#   Add MMZ failed ... load mmz failed!
# Both paths can be overridden from the environment so the zone choice can be
# tried without the kernel it describes: point HISI_MEM_PARAMS at a directory
# holding `allocator` and `mmz` files, CV610_CMDLINE at a fake command line.
# Test hooks only -- the platform conf does not set them.
HISI_MEM_PARAMS=${HISI_MEM_PARAMS:-/sys/module/hisi_mem/parameters}
CV610_CMDLINE=${CV610_CMDLINE:-/proc/cmdline}
MMZ_ALLOCATOR=ot
MMZ_ZONE=anonymous,0,${CV610_MMZ_START:-0x44000000},${CV610_MMZ_SIZE:-64M}

# The platform conf offers START/SIZE as the way to move the zone, so when
# something else owns it -- the kernel's own layout, or a mmz= carve-out named
# on the command line -- warn instead of swallowing what an operator set.
warn_mmz_ignored()
{
	echo "warning: $1; CV610_MMZ_START/SIZE ignored, open_mmz gets $MMZ_ZONE" >&2
}

hm_alloc=$(cat "$HISI_MEM_PARAMS/allocator" 2>/dev/null)
hm_mmz=$(cat "$HISI_MEM_PARAMS/mmz" 2>/dev/null)
# Gated on the allocator alone, as load_hisilicon does: a kernel that
# publishes one has laid memory out itself, so falling back to ot would only
# trade an empty mmz= for the MMZ conflict above.
if [ -n "$hm_alloc" ]; then
	MMZ_ALLOCATOR=$hm_alloc
	# Possibly empty: start_modules refuses then, since the bootloader zone
	# is no fallback here -- it lies inside the kernel's memory.
	MMZ_ZONE=$hm_mmz
	# The kernel has reserved the range already: CV610_MMZ_START/SIZE cannot
	# move it; OpenIPC's set_allocator plus a reboot can.
	if [ -n "$hm_mmz" ] && [ -n "${CV610_MMZ_START:-}${CV610_MMZ_SIZE:-}" ]; then
		warn_mmz_ignored "the kernel laid memory out itself"
	fi
else
	# No hisi_mem: the zone is a bootloader carve-out. The first mmz= on the
	# kernel command line wins over CV610_MMZ_START/SIZE, and CMA provides that
	# zone rather than MMZ's own allocator.
	cmdmz=$(awk -F= '$1 == "mmz" {print $2; exit}' RS=' ' "$CV610_CMDLINE")
	if [ -n "${cmdmz:-}" ]; then
		MMZ_ALLOCATOR=cma
		MMZ_ZONE=$cmdmz
		if [ -n "${CV610_MMZ_START:-}${CV610_MMZ_SIZE:-}" ]; then
			warn_mmz_ignored "the command line names the carve-out"
		fi
	fi
fi
# Clock profile for the initial insmod; the daemon retunes it per mode.
SENSOR_PROFILE=${CV610_SENSOR_PROFILE:-imx662}
# Analog microphone on the inner ACODEC. Off by default so the hardware-verified
# video-only module set stays the default boot path.
AUDIO=${CV610_AUDIO:-0}
loaded=""

# Checked before anything is unloaded or loaded, so a refused start or restart
# leaves the board exactly as it was.
require_zone()
{
	[ -n "$MMZ_ZONE" ] && return 0
	echo "hisi_mem publishes an allocator but no mmz zone; not loading" >&2
	return 1
}

is_loaded()
{
	grep -q "^$1 " /proc/modules
}

# Character devices created by the modules below. Derived from the target's
# actual /dev, not from module names -- guessing from names missed ot_mipi_rx
# (not "mipi_rx"), logmpp and venc_msg. To re-derive after a module set change:
#   ls -l /dev | awk '$1 ~ /^c/ {print $NF}' | sort   # before and after a load
# Built by concatenation, not as one multi-line literal: the lookup below matches
# on " name ", so a name landing on a line boundary would carry a newline
# instead of a space and never match at all.
MPP_DEVICES="ab acodec adec aenc ai aio ao bus chnl h265e i2c isp_dev logmpp"
MPP_DEVICES="$MPP_DEVICES mipi_rx mmz_userdev ot_mipi_rx rc rgn sys user vb"
MPP_DEVICES="$MPP_DEVICES vca venc venc_msg vgs vi vpp vpss"

is_mpp_device()
{
	case "$1" in /dev/*) ;; *) return 1 ;; esac
	case " $MPP_DEVICES " in *" ${1#/dev/} "*) return 0 ;; esac
	return 1
}

# Processes holding one of those devices open, minus any pid in $1.
#
# The drivers do not set .owner on their file operations, so opening the device
# takes no module reference -- /proc/modules reports open_rgn "used=0" while a
# consumer holds /dev/rgn. rmmod therefore succeeds under a live consumer and
# frees the file operations it is still using, wedging the SoC hard enough to
# need a physical power cycle. waybeam_hub is the one that matters in practice:
# it holds /dev/rgn for the CV610 RGN OSD.
mpp_holders()
{
	ignore=" ${1:-} "
	for fd in /proc/[0-9]*/fd/*; do
		[ -L "$fd" ] || continue
		is_mpp_device "$(readlink "$fd" 2>/dev/null)" || continue
		pid=${fd#/proc/}
		pid=${pid%%/*}
		case "$ignore" in *" $pid "*) continue ;; esac
		echo "$pid($(cat "/proc/$pid/comm" 2>/dev/null))"
	done | sort -u | tr '\n' ' '
}

load_stock()
{
	name=$1
	shift
	echo "load $name"
	insmod "$MODULE_DIR/$name.ko" "$@" || return 1
	loaded="$name $loaded"
}

# Rollback for a load sequence that failed part way through.  Carries the same
# guard as stop_modules(): a consumer can grab a device created EARLIER in this
# very sequence -- waybeam_hub rebinds /dev/rgn within ~1s of open_rgn appearing,
# and the sequence runs for seconds afterwards -- and unloading under it wedges
# the SoC hard enough to need a physical power cycle.  Leaving the modules loaded
# is recoverable; a wedged SoC is not.
cleanup_partial()
{
	set +e
	holders=$(mpp_holders)
	if [ -n "$holders" ]; then
		echo "partial load failed; NOT unloading -- MPP devices open by $holders" >&2
		echo "stop those consumers, then run '$0 stop' to clear the partial state" >&2
		return 0
	fi
	for name in $loaded; do
		rmmod "$name" 2>/dev/null
	done
}

start_modules()
{
	[ -r "$ARTIFACT_DIR/open_sys_config_imx662.ko" ] || {
		echo "missing patched IMX662 sys_config module" >&2
		return 1
	}
	[ -r "$ARTIFACT_DIR/open_pm_stub.ko" ] || {
		echo "missing registration-only PM shim" >&2
		return 1
	}
	is_loaded open_pm && {
		echo "refusing vendor open_pm" >&2
		return 1
	}
	# open_user is the last module the sequence loads, so its presence means a
	# previous run completed. Loading is idempotent from here: a venc restart
	# re-inits the graph against the modules already up, the way star6e and
	# maruko have always worked. Only a *partial* set is dirty.
	if is_loaded open_user && is_loaded open_base; then
		if [ "$AUDIO" = "1" ] && ! is_loaded open_acodec; then
			# Reboot, not a reload. Swapping the module set means unloading,
			# and a boot that has already seen a hard kill cannot load them
			# back -- the craft ends up with no modules at all. A reboot
			# applies the profile the platform conf asks for, every time.
			echo "modules are up but were loaded without audio;" >&2
			echo "reboot to bring them up with the configured profile" >&2
			return 1
		fi
		echo "MPP modules already loaded"
		return 0
	fi
	is_loaded open_base && {
		echo "refusing dirty MPP module state" >&2
		return 1
	}
	require_zone || return 1

	trap cleanup_partial EXIT HUP INT TERM
	echo "load patched open_sys_config"
	insmod "$ARTIFACT_DIR/open_sys_config_imx662.ko" \
		sensors=sns0="$SENSOR_PROFILE",sns1="$SENSOR_PROFILE" \
		board=dmeb_qfn ir_auto=0 || return 1
	loaded="open_sys_config $loaded"
	load_stock open_osal proc_show=1 || return 1
	load_stock open_mmz anony=1 mmz_allocator="$MMZ_ALLOCATOR" \
		mmz="$MMZ_ZONE" mem_process_isolation=0 || return 1
	load_stock open_base logmpp_show=1 || return 1

	echo "load registration-only PM shim"
	insmod "$ARTIFACT_DIR/open_pm_stub.ko" || return 1
	loaded="open_pm_stub $loaded"
	is_loaded open_pm_stub || return 1
	is_loaded open_pm && return 1

	load_stock open_vb || return 1
	load_stock open_vca || return 1
	load_stock open_sys profile=0 || return 1
	load_stock open_rgn || return 1
	load_stock open_vpp || return 1
	load_stock open_vgs || return 1
	load_stock open_vpss || return 1
	load_stock open_vi || return 1
	load_stock open_isp || return 1
	load_stock open_chnl || return 1
	load_stock open_rc || return 1
	load_stock open_venc g_venc_max_chn_num=8 || return 1
	load_stock open_h265e || return 1
	# JPEG encode is a separate codec module. Without it the H.265 path runs
	# fine but ss_mpi_venc_create_chn() for an OT_PT_JPEG channel returns
	# OT_ERR_NOT_READY (0xa0088018) -- device-confirmed on the SIP-K662C6S,
	# where loading it turns that same create_chn(7) into a working 1280x720
	# snapshot.  Deliberately NOT fatal: snapshot is optional and venc
	# degrades to a 503 on /api/v1/snapshot.jpg, so a firmware that ships no
	# open_jpege.ko must still get video.
	if ! load_stock open_jpege; then
		echo "warning: open_jpege not loaded; /api/v1/snapshot.jpg will 503" >&2
	fi
	# Deliberately NOT added to MPP_DEVICES: device-checked on the target,
	# open_jpege creates no /dev node of its own (129 char devices with and
	# without it, empty diff).  JPEG encoding goes through the existing
	# /dev/venc, which the list already covers.  Adding "jpege" on the
	# strength of the module name is the guess this file warns against
	# above, and it would have named a device that can never be held.

	# AI capture only: open_ao/open_adec are playback-side and stay out.
	# open_acodec drives the analog front end and must come after open_aio.
	if [ "$AUDIO" = "1" ]; then
		load_stock open_aio || return 1
		load_stock open_ai || return 1
		load_stock open_aenc || return 1
		load_stock open_acodec || return 1
	fi

	load_stock open_sensor_i2c || return 1
	load_stock open_mipi_rx || return 1
	load_stock open_user || return 1
	loaded=""
	trap - 0 1 2 15
	return 0
}

stop_modules()
{
	# Guard the rmmod itself, not its callers: any unload is fatal with a
	# consumer still attached.  The partial-load rollback carries the same
	# guard (see cleanup_partial); a hand-run stop is the only other caller.
	holders=$(mpp_holders)
	if [ -n "$holders" ]; then
		echo "refusing to unload: MPP devices still open by $holders" >&2
		echo "stop those consumers first, e.g. /etc/init.d/S97waybeam-hub stop" >&2
		return 1
	fi
	modules="open_user open_mipi_rx open_sensor_i2c \
		open_acodec open_aenc open_ai open_aio \
		open_jpege open_h265e open_venc open_rc open_chnl open_isp open_vi \
		open_vpss open_vgs open_vpp open_rgn open_sys open_vca open_vb \
		open_pm_stub open_base open_mmz open_osal open_sys_config"
	rc=0
	set +e
	for name in $modules; do
		if is_loaded "$name" && ! rmmod "$name"; then
			echo "failed to unload $name" >&2
			rc=1
		fi
	done
	for name in $modules; do
		if is_loaded "$name"; then
			echo "module still loaded after stop: $name" >&2
			rc=1
		fi
	done
	return "$rc"
}

case "${1:-}" in
	start) start_modules ;;
	stop) stop_modules ;;
	restart)
		require_zone && stop_modules && start_modules
		;;
	holders)
		# Callers that must decide *before* destroying state ask here, passing
		# the pids they own as one space-separated argument.
		mpp_holders "${2:-}"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|holders [ignore-pids]}" >&2
		exit 1
		;;
esac
