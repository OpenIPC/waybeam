#!/bin/sh

DAEMON=/usr/bin/waybeam
LOADER=/usr/bin/load-cv610-online
NAME=waybeam
RESPAWN=waybeam-resp
WATCHDOG=waybeam-wd
PIDFILE=/var/run/$NAME.pid
# Keep a privileged daemon's redirect outside world-writable /tmp.  OpenIPC
# maps /var/log back to /tmp, while /var/run maps to root-owned /run.  The
# respawn helper uses the same backend-specific path.
LOGFILE=/var/run/$NAME.log
PLATFORM_CONFIG=/etc/waybeam-cv610.conf

WAYBEAM_ENABLED=1
# Sensor clock the modules load with.  Fallback only: the daemon sets the
# clock for the selected mode at bring-up via sns0_clk_hz, so this matters
# solely against a sys_config too old to expose that parameter, where it must
# match video0.fps (sc4336p = 27 MHz for 100 fps, imx662 = 37.125 MHz for
# 30/60/90).  It names a clock profile, not the sensor: the daemon takes the
# sensor from $SENSOR (see start()).  Keep it a name the craft's sys_config
# knows; sc4336p always is.
CV610_SENSOR_PROFILE=sc4336p
CV610_AUDIO=0
# MMZ placement for the loader; empty keeps its defaults (0x44000000, 64M).
# Ignored where the kernel laid memory out itself (hisi_mem), which is every
# OpenIPC CV610 image; see the platform conf before changing either.
CV610_MMZ_START=
CV610_MMZ_SIZE=
# The platform override is target-local by design.
# shellcheck disable=SC1090
[ -r "$PLATFORM_CONFIG" ] && . "$PLATFORM_CONFIG"

# API restart forks a short-lived waybeam-resp helper and the successor gets
# a new PID. The pidfile therefore identifies only the original launch and
# must never be used as proof that the graph is idle before unloading modules.
still_running()
{
	pidof "$NAME" "$RESPAWN" "$WATCHDOG" >/dev/null 2>&1
}

start()
{
	if [ "$WAYBEAM_ENABLED" != "1" ]; then
		echo "$NAME disabled by configuration"
		return 0
	fi
	if still_running; then
		echo "$NAME already running"
		return 0
	fi
	if [ -r "$PIDFILE" ]; then
		rm -f "$PIDFILE"
	fi
	CV610_SENSOR_PROFILE="$CV610_SENSOR_PROFILE" \
		CV610_MMZ_START="$CV610_MMZ_START" CV610_MMZ_SIZE="$CV610_MMZ_SIZE" \
		CV610_AUDIO="$CV610_AUDIO" "$LOADER" start || return 1
	# The daemon picks its sensor plugin and mode table from $SENSOR, the
	# u-boot `sensor` name.  rcS exports it at boot; a start from a context
	# that did not inherit it (a non-login ssh command, a script) asks where
	# rcS and OpenIPC's loader do.  Unset, the daemon warns and assumes
	# IMX662.
	[ -n "${SENSOR:-}" ] || SENSOR=$(fw_printenv -n sensor 2>/dev/null)
	[ -n "${SENSOR:-}" ] || SENSOR=$(ipcinfo --short-sensor 2>/dev/null)
	export SENSOR
	: >"$LOGFILE"
	start-stop-daemon -S -m -q -p "$PIDFILE" -x "$DAEMON" -- \
		>>"$LOGFILE" 2>&1 &
	sleep 2
	if ! still_running; then
		echo "$NAME failed to start" >&2
		cat "$LOGFILE" >&2
		rm -f "$PIDFILE"
		# Deliberately no module rollback here. The loader's start is
		# idempotent -- it returns success having done nothing when the set is
		# already up -- so unloading on a failed daemon start tears down a set
		# this invocation did not create. That is the same hazard as the
		# deleted reload action, on the worse path: a venc that dies at
		# bring-up is usually a venc that was hard-killed earlier, and on such
		# a boot the modules cannot be loaded back. Leaving them up costs
		# nothing; the next start re-inits against them.
		return 1
	fi
	echo "Started $NAME (sensor profile $CV610_SENSOR_PROFILE, audio $CV610_AUDIO)"
}

stop()
{
	# Cover the current daemon plus either side of an API-respawn handoff.
	killall "$NAME" "$RESPAWN" "$WATCHDOG" 2>/dev/null || true
	i=0
	while still_running && [ "$i" -lt 100 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	if still_running; then
		echo "$NAME did not stop within 10 seconds" >&2
		return 1
	fi
	rm -f "$PIDFILE"
	# The MPP modules stay loaded, the way they do on star6e and maruko. venc
	# tears its own graph down in mpp_cleanup() -- including vb_exit() from the
	# process that created it, which is the only process allowed to -- so the
	# next start re-inits against the modules already up. Unloading them here
	# was bring-up scaffolding, and it is what wedged the SoC whenever a
	# consumer still held one of their devices.
	echo "Stopped $NAME (MPP modules left loaded)"
}

# There is deliberately no "reload" action. It existed to unload and reload the
# MPP modules after a venc that died without mpp_cleanup(), on the premise that
# VB was left held by a dead owner -- a premise the hardware disproved in the
# same release that added it: VB *is* released when the process dies, and what a
# crash actually leaves behind (ISP, and the AI device claim) venc now pre-cleans
# itself. A hard-killed venc recovers from a plain start, video and audio both.
#
# Nothing in production called it, and unloading is not free: a hard kill
# poisons module reloading for the rest of the boot, so a reload issued
# afterwards leaves the craft with no modules at all -- or, measured on a
# video-only craft, resets the SoC. Recovery after a hard kill is a plain start;
# applying a module-parameter change (CV610_AUDIO, sensor profile) is a reboot.
#
# 'load-cv610-online restart' still exists for a dirty/partial module set, but
# run it BARE and it reloads with the loader's own defaults -- video-only,
# imx662 clock -- not this craft's profile. That caveat used to live inside
# reload(); it is stated here because it outlived the function. Prefer
# 'load-cv610-online stop' followed by 'S95waybeam start', which passes
# CV610_SENSOR_PROFILE and CV610_AUDIO for you.
case "${1:-}" in
	start|stop) "$1" ;;
	restart) stop && start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
