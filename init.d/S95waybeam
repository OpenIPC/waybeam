#!/bin/sh

DAEMON="waybeam"
RESPAWN="waybeam-resp"
WATCHDOG="waybeam-wd"
DAEMON_PATH="/usr/bin/waybeam"
LOG_PATH="/tmp/waybeam.log"

# waybeam forks a respawn child on SIGHUP / API restart that changes
# its comm to "waybeam-resp" so the new process can survive the
# parent's teardown, plus a watchdog "waybeam-wd" that SIGKILLs a
# hung parent.  pidof and killall match by comm, so any restart logic
# must cover all three names — otherwise stop() returns while an
# orphan helper is still alive and the next start() trips waybeam's
# /proc-walk duplicate-instance check.
still_running() {
    pidof "$DAEMON" "$RESPAWN" "$WATCHDOG" >/dev/null 2>&1
}

# In apfpv mode (wfbmode != 1) venc must output udp:// so a discovered
# ground/phone can live-retarget the stream via a subscribe. venc refuses
# a live switch *away from* shm:// (it requires a restart), so an apfpv box
# that boots with shm:// can never be subscribed to without a restart.  The
# shared /etc/waybeam.json ships shm://local_shm for the wfb build (it feeds
# wfb-air); when we boot apfpv, rewrite that to a harmless udp default
# (loopback — no stray RTP on the air until a subscribe sets the real dst).
ensure_apfpv_udp_output() {
    [ "$(fw_printenv -n wfbmode 2>/dev/null || echo 0)" = "1" ] && return 0
    command -v json_cli >/dev/null 2>&1 || return 0
    [ -f /etc/waybeam.json ] || return 0
    cur=$(json_cli -g .outgoing.server -i /etc/waybeam.json 2>/dev/null)
    case "$cur" in
        shm://*)
            if json_cli -s .outgoing.server '"udp://127.0.0.1:5600"' \
                    -i /etc/waybeam.json; then
                echo "apfpv: venc output $cur -> udp://127.0.0.1:5600 (awaiting subscribe)"
            fi
            ;;
    esac
    # Unconnected UDP for the subscribe topology. A connect()ed socket gets
    # ICMP-poisoned and wedges to 0 bytes (config still looks healthy) when the
    # subscribe target goes unreachable — e.g. the ground/phone's DHCP lease
    # churns to a new IP. An unconnected sendto() keeps emitting, so a
    # re-subscribe recovers the stream without a venc restart.
    if [ "$(json_cli -g .outgoing.connectedUdp -i /etc/waybeam.json 2>/dev/null)" != "false" ]; then
        if json_cli -s .outgoing.connectedUdp false -i /etc/waybeam.json; then
            echo "apfpv: venc outgoing.connectedUdp -> false (unconnected UDP)"
        fi
    fi
    # Clamp RTP payload to the wifi-safe 1400. wfb-ng is a special case: its
    # link_controller sizes venc outgoing.maxPayloadSize up the bitrate tiers
    # (to ~3200, carried by the 4052 monitor-mode MTU) and persists it into
    # /etc/waybeam.json. On a plain apfpv wifi link those oversized payloads
    # fragment / overflow and wedge weaker adapters, so reset to 1400 here.
    # wfb mode (wfbmode=1) returns early above, leaving link_controller free to
    # re-size it live.
    if [ "$(json_cli -g .outgoing.maxPayloadSize -i /etc/waybeam.json 2>/dev/null)" != "1400" ]; then
        if json_cli -s .outgoing.maxPayloadSize 1400 -i /etc/waybeam.json; then
            echo "apfpv: venc outgoing.maxPayloadSize -> 1400 (wifi-safe)"
        fi
    fi
}

# Small Maruko flash layouts cannot hold the compiled detector image and its
# runtime copy at once.  A deploy may therefore keep the configured /tmp model
# as an xz archive under /root/models.  Inflate only the exact configured
# basename before waybeam starts; failures are non-fatal because detection is
# best-effort and the encoder must still boot.
stage_detect_model() {
    command -v json_cli >/dev/null 2>&1 || return 0
    command -v xz >/dev/null 2>&1 || return 0
    [ -f /etc/waybeam.json ] || return 0
    model=$(json_cli -g .detect.modelPath --raw \
        -i /etc/waybeam.json 2>/dev/null) || return 0
    case "$model" in
        /tmp/*.img)
            archive="/root/models/$(basename "$model").xz"
            [ -s "$archive" ] || return 0
            tmp="${model}.new"
            if xz -dc "$archive" > "$tmp"; then
                mv "$tmp" "$model"
                echo "detect: staged $(basename "$model") from flash archive"
            else
                rm -f "$tmp"
                echo "Warning: failed to stage detector model $archive"
            fi
            ;;
    esac
}

# Wait up to $1 seconds for the daemon (and any orphan helper) to exit.
# Never SIGKILL: venc's SIGTERM handler is what releases the SigmaStar
# MI_SYS / MI_VENC kernel state, and a killed venc leaves it wedged until a
# power cycle.  A venc that ignores 30 s of SIGTERM is already hung there.
wait_exit() {
    i=0
    while [ $i -lt $(($1 * 2)) ]; do
        still_running || return 0
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

# unix:// video output rides an AF_UNIX datagram socket, which blocks the
# sender on the *receiver's* queue depth.  The kernel snapshots that depth
# from net.unix.max_dgram_qlen when the receiving socket is created, so this
# must be raised before any consumer starts — raising it later does nothing
# for sockets that already exist.
#
# The default of 10 datagrams is ~7 ms of buffer at 15 Mbps with 1400-byte
# RTP payloads.  A single 60 fps frame is ~23 packets, so every frame
# overruns the queue and stalls venc's encode thread waiting on consumer
# scheduling.  256 gives ~180 ms, which absorbs ordinary jitter.
raise_unix_dgram_qlen() {
    qlen_path=/proc/sys/net/unix/max_dgram_qlen
    [ -w "$qlen_path" ] || return 0
    cur=$(cat "$qlen_path" 2>/dev/null) || return 0
    [ "$cur" -ge 256 ] 2>/dev/null && return 0
    if echo 256 > "$qlen_path" 2>/dev/null; then
        echo "venc: net.unix.max_dgram_qlen $cur -> 256 (unix:// output buffer)"
    fi
}

start() {
    # A venc that was just sent SIGTERM still shows in pidof while it tears
    # down (up to ~10 s in MI_SYS_Exit).  Calling that "already running"
    # returned 0 and left nothing running once it exited, so let it finish
    # first.  A start against a healthy instance costs only this wait.
    if still_running && ! wait_exit 10; then
        echo "$DAEMON already running"
        return 0
    fi
    echo -n "Starting $DAEMON: "
    # apfpv boxes must come up in udp output mode (see helper above).
    ensure_apfpv_udp_output
    raise_unix_dgram_qlen
    stage_detect_model
    # waybeam reads /etc/waybeam.json from a fixed path; it has no -c flag.
    "$DAEMON_PATH" > "$LOG_PATH" 2>&1 &
    # Confirm the daemon survived the /proc-walk duplicate-instance
    # gate.  If an orphan respawn child is still alive it will reject
    # us with "waybeam already running... exiting" and the bg launch
    # discards that exit status — poll briefly so a lost race surfaces
    # as FAILED instead of silently leaving the old binary running.
    i=0
    while [ $i -lt 10 ]; do
        sleep 0.3
        still_running && { echo "OK"; return 0; }
        i=$((i + 1))
    done
    echo "FAILED (lost duplicate-instance check or crashed at init — see $LOG_PATH)"
    return 1
}

stop() {
    echo -n "Stopping $DAEMON: "
    killall "$DAEMON" "$RESPAWN" "$WATCHDOG" 2>/dev/null
    if wait_exit 30; then
        echo "OK"
        return 0
    fi
    echo "FAILED: still running after 30 s of SIGTERM; not sending SIGKILL" \
        "(it wedges the SigmaStar encoder until a power cycle), reboot to recover"
    return 1
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop && start ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
